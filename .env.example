# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto HTTP del backend
PORT=3000

# Origen permitido por CORS (frontend)
FRONTEND_URL=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tcit_posts

# Base dedicada a tests (debe terminar en _test)
TEST_DB_NAME=tcit_posts_test
